{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "starquest-ledger",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-23",
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "starquest-ledger",
      "database_id": "a1a973b2-a37c-4e1c-b68e-a73803238206"
    }
  ]
}
